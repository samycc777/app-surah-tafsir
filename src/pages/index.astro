---
import App from '../layouts/App.astro';
import Icon from '../components/Icon.astro';
import { META, JUZ, ar, ayahWord } from '../lib.mjs';
---
<App>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="orn" viewBox="0 0 60 60">
      <rect x="11" y="11" width="38" height="38" rx="3" style="fill:var(--orn-fill);stroke:var(--orn-line);stroke-width:1.4" />
      <rect x="11" y="11" width="38" height="38" rx="3" style="fill:var(--orn-fill);stroke:var(--orn-line);stroke-width:1.4" transform="rotate(45 30 30)" />
      <circle cx="30" cy="30" r="14.5" style="fill:var(--orn-fill);stroke:var(--orn-line);stroke-width:1.1" />
      <circle cx="30" cy="3.5" r="1.6" style="fill:var(--orn-line)" /><circle cx="30" cy="56.5" r="1.6" style="fill:var(--orn-line)" />
      <circle cx="3.5" cy="30" r="1.6" style="fill:var(--orn-line)" /><circle cx="56.5" cy="30" r="1.6" style="fill:var(--orn-line)" />
    </symbol>
  </svg>

  <section class="hero">
    <form class="pill" action="/search/" method="get" role="search">
      <Icon name="search" size={22} />
      <input type="search" name="q" placeholder="البحث في التفسير" aria-label="البحث في التفسير" />
    </form>
  </section>

  <section class="recent" id="resume-wrap" hidden>
    <h2 class="h-ico"><Icon name="clock" size={22} /><span>قُرئ مؤخراً</span></h2>
    <a class="scard" id="resume" href="/">
      <span class="badge"><svg viewBox="0 0 60 60"><use href="#orn" /></svg><b class="bn"></b></span>
      <span class="txt"><span class="sname"></span><span class="smeta"></span></span>
      <Icon name="arrow" size={22} class="go" />
    </a>
  </section>

  <div class="tabs" role="tablist">
    <button type="button" role="tab" class="tab on" data-tab="s" aria-selected="true">السور</button>
    <button type="button" role="tab" class="tab" data-tab="j" aria-selected="false">الأجزاء</button>
  </div>

  <div class="list" id="tab-s">
    <div class="card searchbar s-find">
      <Icon name="search" size={20} />
      <input type="search" id="s-find" placeholder="ابحث عن سورة: اسمها أو رقمها" aria-label="ابحث عن سورة" autocomplete="off" />
    </div>
    <p class="note s-none" id="s-none" hidden>لا توجد سورة بهذا الاسم</p>
    {META.map((m) => (
      <a class="scard" href={`/surah/${m.n}/`}>
        <span class="badge"><svg viewBox="0 0 60 60"><use href="#orn" /></svg><b class="bn">{ar(m.n)}</b></span>
        <span class="txt">
          <span class="sname">سورة {m.name}</span>
          <span class="smeta">{m.place} · {ar(m.ayahs)} {ayahWord(m.ayahs)}</span>
        </span>
        <Icon name="arrow" size={22} class="go" />
      </a>
    ))}
  </div>

  <div class="list" id="tab-j" hidden>
    {JUZ.map((j) => (
      <>
        <a class="juz-pill" href={`/surah/${j.parts[0].n}/#${j.parts[0].a}`}>
          <b>الجزء {ar(j.j)}</b><span>(من صفحة {ar(j.first)} إلى {ar(j.last)})</span>
        </a>
        {j.parts.map((p) => (
          <a class="scard" href={`/surah/${p.n}/#${p.a}`}>
            <span class="badge"><svg viewBox="0 0 60 60"><use href="#orn" /></svg><b class="bn">{ar(p.n)}</b></span>
            <span class="txt">
              <span class="sname">سورة {p.name}</span>
              <span class="smeta">من آية {ar(p.a)} إلى {ar(p.b)}</span>
            </span>
            <Icon name="arrow" size={22} class="go" />
          </a>
        ))}
      </>
    ))}
  </div>
</App>
