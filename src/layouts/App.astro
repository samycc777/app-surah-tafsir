---
import '../styles/app.css';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib.mjs';

const { title, back = null, sub, nav = true } = Astro.props;
const path = Astro.url.pathname;
const is = (p) => (p === '/' ? path === '/' : path.startsWith(p));
const tabs = [
  ['/', 'السور', 'book'],
  ['/search/', 'البحث', 'search'],
  ['/saved/', 'المحفوظات', 'bookmark'],
];
const full = title ? `${title} · تفسير السعدي` : `${SITE.title} · ${SITE.sub}`;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#1f4d40" />
    <meta name="description" content={`${SITE.book} – ${SITE.author}`} />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITE.title} />
    <link rel="preload" href="/fonts/DroidNaskh-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-kufi-arabic-arabic-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{full}</title>
  </head>
  <body>
    <header class="bar">
      <div class="bar-in">
        {back ? (
          <a class="iconbtn" href={back} aria-label="رجوع"><Icon name="back" /></a>
        ) : (
          <span class="iconbtn ghost" aria-hidden="true"></span>
        )}
        <a class="brand" href="/">
          <strong>{SITE.title}</strong>
          <small>{sub ?? SITE.sub}</small>
        </a>
        <button class="iconbtn" id="open-settings" aria-label="الإعدادات" type="button">
          <Icon name="settings" />
        </button>
      </div>
    </header>

    <main class="page"><slot /></main>

    {nav && (
      <nav class="tabbar" aria-label="التنقل">
        {tabs.map(([href, label, icon]) => (
          <a href={href} class={is(href) ? 'on' : undefined}>
            <Icon name={icon} /><span>{label}</span>
          </a>
        ))}
      </nav>
    )}

    <div class="sheet-wrap" id="settings" hidden>
      <div class="backdrop" data-close></div>
      <section class="sheet" role="dialog" aria-modal="true" aria-labelledby="set-title">
        <div class="grab"></div>
        <header class="sheet-head">
          <h2 id="set-title">الإعدادات</h2>
          <button class="iconbtn" data-close aria-label="إغلاق" type="button"><Icon name="close" /></button>
        </header>
        <div class="sheet-body">
          <label class="row">
            <span>
              <b>الحركات</b>
              <small>إظهار التشكيل في نص التفسير</small>
            </span>
            <input type="checkbox" id="set-harakat" class="switch" />
          </label>
          <div class="row">
            <span><b>حجم الخط</b><small>للقرآن والتفسير</small></span>
            <span class="seg">
              <button type="button" id="fs-down" aria-label="تصغير">أ−</button>
              <button type="button" id="fs-up" aria-label="تكبير">أ+</button>
            </span>
          </div>
          <button type="button" class="row" id="install" hidden>
            <span><b>تثبيت التطبيق</b><small>على الشاشة الرئيسية، ويعمل دون اتصال</small></span>
            <Icon name="install" />
          </button>
          <a class="row" href="/about/">
            <span><b>عن التطبيق</b><small>المصادر والملاحظات</small></span>
            <Icon name="chevron" />
          </a>
        </div>
      </section>
    </div>

    <div class="toast" id="toast" hidden></div>
    <script is:inline src="/js/app.js" defer></script>
  </body>
</html>
